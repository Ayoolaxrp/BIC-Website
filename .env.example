# Copy this file to `.env` and fill in real values.
# The app works without these (forms fall back to local storage) —
# but for production storage + payments, all four are needed.

# --- Supabase (database) ---
# Project URL + anon key: https://supabase.com/dashboard/project/<ref>/settings/api
# Then run supabase/migrations (see supabase/SETUP.md) in the SQL editor to create the tables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Paystack (payments) ---
# Test key: pk_test_...   Production key: pk_live_...
# Get it from https://dashboard.paystack.com/#/settings/developers
VITE_PAYSTACK_PUBLIC_KEY=

# Kora checkout: both flags default off. Never expose secret keys with VITE_.
VITE_KORA_CHECKOUT_ENABLED=false
KORA_CHECKOUT_ENABLED=false
# Server-only, existing Vercel variable names:
KORAPAY_SECRET_KEY=
SUPABASE_SECRET_KEY=
# Existing browser-safe config is also read by the server:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SITE_URL=https://your-site.example (no trailing slash)

# Sector WhatsApp invite links, shown only after a verified Kora payment. Server-only (no VITE_ prefix):
# the repo is public, so the links must never be committed or put in src/. One line of JSON, keys are
# the sector values Crypto, Forex, Securities, "Real Estate", General, plus Members (the main registered-members chat, used as the catch-all group
# for any sector without its own group). Set it in Vercel and redeploy.
# BIC_SECTOR_LINKS={"Crypto":"https://chat.whatsapp.com/...","Securities":"...","Forex":"...","Real Estate":"...","Members":"..."}
